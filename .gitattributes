# Keep downloaded originals and bundled font/license files byte-for-byte.
assets/finni/originals/** -text
assets/fonts/** -text
runtime/*.vpx filter=lfs diff=lfs merge=lfs -text
three/public/*.bin binary
three/public/arcade-background.svg -text
three/public/fonts/** -text
# Preserve the original compiled VPX shader bytes, including upstream whitespace.
three/public/native-actors/*.glsl -text -whitespace

three/public/native-table/*.glsl -text -whitespace
three/public/native-transmission/*.glsl -text -whitespace
