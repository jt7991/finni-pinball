    "runtimeMarkers": {
      "code": "Dim RefTraceOn,RefTrace\nRefTraceOn=False:RefTrace=\"\"\nDim RefDriveAt,RefDriveSide,RefDrivePress,RefDriveMarker,RefTraceBall,RefTraceUntil,RefStateTraceOn,RefTraceFrom\nRefDriveAt=0:RefStateTraceOn=True:RefTraceFrom=0\n\nDim RefAnimationPreviousClock\nRefAnimationPreviousClock=0\nSub Target010_Timer\n    If RefTraceOn Then Debug.Print \"ANIMATION_FRAME|\" & GameTime & \"|\" & GameTime-RefAnimationPreviousClock & \"|\" & CStr(CDbl(Target009.CurrentAnimOffset)) & \"|\" & CStr(CDbl(Target010.CurrentAnimOffset)) & \"|\" & CStr(CDbl(Target011.CurrentAnimOffset)) & \"|\" & CLng(Target009.IsDropped) & \"|\" & CLng(Target010.IsDropped) & \"|\" & CLng(Target011.IsDropped) & \"|\" & Score(CurrentPlayer)\n    RefAnimationPreviousClock=GameTime\nEnd Sub\n\nSub Target010_Hit\n    If RefTraceOn Then RefTrace=RefTrace & \"TARGET|\" & GameTime & \"|Target010|\" & CStr(CDbl(ActiveBall.VelX)) & \"|\" & CStr(CDbl(ActiveBall.VelY)) & \"|\" & CStr(CDbl(ActiveBall.VelZ)) & \"|\" & CStr(CDbl(Target010.HitThreshold)) & \";\"\nEnd Sub\nDim RefTrailOn,RefTrailSlots(9),RefTrailBalls,RefTrailBall,RefTrailIndex,RefTrailRow,RefTrailSlot\nRefTrailOn=False\nSub LeftFlipper_Timer 'flipper's tricks timer\n    If RefTraceOn Then RefTrace=RefTrace & \"FLIP|\" & GameTime & \";\"\n    If RefDriveAt>0 And GameTime>=RefDriveAt Then\n        RefDriveAt=0\n        Debug.Print RefDriveMarker & \"|\" & GameTime\n        If RefDriveSide=1 Then\n            SolLFlipper RefDrivePress\n        ElseIf RefDriveSide=2 Then\n            SolRFlipper RefDrivePress\n        ElseIf RefDriveSide=3 Then\n            Plunger.Fire\n        End If\n    End If\n    'Start Of Stroke Flipper Stroke Routine : Start of Stroke for Tap pass and Tap shoot\n    If LeftFlipper.CurrentAngle >= LeftFlipper.StartAngle - SOSAngle Then LeftFlipper.Strength = FlipperPower * SOSTorque else LeftFlipper.Strength = FlipperPower:End If\n\n    'End Of Stroke Routine : Livecatch and Emply/Full-Charged EOS\n    If LeftFlipperOn = 1 Then\n        If LeftFlipper.CurrentAngle = LeftFlipper.EndAngle then\n            LeftFlipper.EOSTorque = FullStrokeEOS_Torque\n            LLiveCatchTimer = LLiveCatchTimer + 1\n            If LLiveCatchTimer <LiveCatchSensivity Then\n                LeftFlipper.Elasticity = 0\n            Else\n                LeftFlipper.Elasticity = FlipperElasticity\n                LLiveCatchTimer = LiveCatchSensivity\n            End If\n        End If\n    Else\n        LeftFlipper.Elasticity = FlipperElasticity\n        LeftFlipper.EOSTorque = LiveStrokeEOS_Torque\n        LLiveCatchTimer = 0\n    End If\n\n    'Start Of Stroke Flipper Stroke Routine : Start of Stroke for Tap pass and Tap shoot\n    If RightFlipper.CurrentAngle <= RightFlipper.StartAngle + SOSAngle Then RightFlipper.Strength = FlipperPower * SOSTorque else RightFlipper.Strength = FlipperPower:End If\n\n    'End Of Stroke Routine : Livecatch and Emply/Full-Charged EOS\n    If RightFlipperOn = 1 Then\n        If RightFlipper.CurrentAngle = RightFlipper.EndAngle Then\n            RightFlipper.EOSTorque = FullStrokeEOS_Torque\n            RLiveCatchTimer = RLiveCatchTimer + 1\n            If RLiveCatchTimer <LiveCatchSensivity Then\n                RightFlipper.Elasticity = 0\n            Else\n                RightFlipper.Elasticity = FlipperElasticity\n                RLiveCatchTimer = LiveCatchSensivity\n            End If\n        End If\n    Else\n        RightFlipper.Elasticity = FlipperElasticity\n        RightFlipper.EOSTorque = LiveStrokeEOS_Torque\n        RLiveCatchTimer = 0\n    End If\n    If RefTraceOn And RefStateTraceOn And GameTime>=RefTraceFrom And GameTime<=RefTraceUntil Then RefTrace=RefTrace & \"STATE|\" & GameTime & \"|\" & RefTraceBall.X & \"|\" & RefTraceBall.Y & \"|\" & RefTraceBall.Z & \"|\" & CLng(RefTraceBall.VelX*1000000) & \"|\" & CLng(RefTraceBall.VelY*1000000) & \"|\" & CLng(RefTraceBall.VelZ*1000000) & \"|\" & CLng(RefTraceBall.AngVelX*1000000) & \"|\" & CLng(RefTraceBall.AngVelY*1000000) & \"|\" & CLng(RefTraceBall.AngVelZ*1000000) & \"|\" & RightFlipper.CurrentAngle & \"|\" & RightFlipper.Strength & \"|\" & RightFlipper.Elasticity & \"|\" & RightFlipper.EOSTorque & \";\"\n    If RefTraceOn Then Debug.Print \"RNG_FRAME|\" & GameTime & \"|\" & CLng(Rnd(0)*16777216)\n    If RefTrailOn Then\n        RefTrailBalls=GetBalls\n        RefTrailRow=CStr(GameTime-1) & \"|\"\n        For RefTrailIndex=0 To UBound(RefTrailBalls)\n            Set RefTrailBall=RefTrailBalls(RefTrailIndex)\n            RefTrailRow=RefTrailRow & RefTrailBall.ID & \":\" & CStr(CDbl(RefTrailBall.X)) & \":\" & CStr(CDbl(RefTrailBall.Y)) & \":\" & CStr(CDbl(RefTrailBall.Z)) & \";\"\n        Next\n        RefTrailSlot=((GameTime-1)\\10) Mod 10\n        RefTrailSlots(RefTrailSlot)=RefTrailRow\n    End If\nEnd Sub\nSub RollingTimer_Timer()\n    If RefTraceOn Then RefTrace=RefTrace & \"ROLL|\" & GameTime & \";\"\n    Dim BOT, b, ballpitch, speedfactorx, speedfactory\n    BOT = GetBalls\n\n    ' stop the sound of deleted balls\n    For b = UBound(BOT) + 1 to tnob\n        rolling(b) = False\n        StopSound(\"fx_ballrolling\" & b)\n    Next\n\n    ' exit the sub if no balls on the table\n    If UBound(BOT) = lob - 1 Then Exit Sub 'there no extra balls on this table\n\n    ' play the rolling sound for each ball\n    For b = lob to UBound(BOT)\n        FinniLockRampAssist BOT(b)\n        If BallVel(BOT(b) )> 1 Then\n            If BOT(b).z <0 Then\n                ballpitch = Pitch(BOT(b) ) - 5000 'decrease the pitch under the playfield\n            ElseIf BOT(b).z <30 Then\n                ballpitch = Pitch(BOT(b) )\n            Else\n                ballpitch = Pitch(BOT(b) ) + 30000 'increase the pitch on a ramp or platform\n            End If\n            rolling(b) = True\n            PlaySound(\"fx_ballrolling\" & b), -1, Vol(BOT(b) ), Pan(BOT(b) ), 0, ballpitch, 1, 0, AudioFade(BOT(b) )\n        Else\n            If rolling(b) = True Then\n                StopSound(\"fx_ballrolling\" & b)\n                rolling(b) = False\n            End If\n        End If\n\n        ' dropping sounds\n        If BOT(b).VelZ <-1 Then\n            'from ramp\n            If BOT(b).z <55 and BOT(b).z> 27 Then PlaySound \"fx_balldrop\", 0, ABS(BOT(b).velz) / 17, Pan(BOT(b) ), 0, Pitch(BOT(b) ), 1, 0, AudioFade(BOT(b) )\n            'down a hole\n            If BOT(b).z <10 and BOT(b).z> -10 Then PlaySound \"fx_hole_enter\", 0, ABS(BOT(b).velz) / 17, Pan(BOT(b) ), 0, Pitch(BOT(b) ), 1, 0, AudioFade(BOT(b) )\n        End If\n\n        ' jps ball spin control\n        BOT(b).AngMomZ = BOT(b).AngMomZ * 0.95\n\n        ' jps ball speed control 2\n        If ABS(BallVel(BOT(b) ) )> maxvel Then\n            If BOT(b).VelX <> 0 Then\n                speedfactorx = ABS(maxvel / BOT(b).VelX)\n                If speedfactorx <1 Then\n                    BOT(b).VelX = BOT(b).VelX * speedfactorx\n                    BOT(b).VelY = BOT(b).VelY * speedfactorx\n                End If\n            End If\n            If BOT(b).VelY <> 0 Then\n                speedfactory = ABS(maxvel / BOT(b).VelY)\n                If speedfactory <1 Then\n                    BOT(b).VelX = BOT(b).VelX * speedfactory\n                    BOT(b).VelY = BOT(b).VelY * speedfactory\n                End If\n            End If\n        End If\n    Next\nEnd Sub\nTarget010.TimerInterval=-1:Target010.TimerEnabled=True\n",
