    {
      "name": "GIUpdateTimer",
      "originalSHA256": "0987fbb9595c342b571ef2ef18f8268b6d8fea67522a5e86651296dc8ca462f3",
      "original": "Sub GIUpdateTimer_Timer\r\n    Dim tmp, obj\r\n    tmp = Getballs\r\n    If UBound(tmp) <> OldGiState Then\r\n        OldGiState = Ubound(tmp)\r\n        If UBound(tmp) = -1 Then '-1 means no balls, 0 is the first captive ball, 1 is the second captive ball...)\r\n            GiOff                ' turn off the gi if no active balls on the table, we could also have used the variable ballsonplayfield.\r\n        Else\r\n            Gion\r\n        End If\r\n    End If\r\nEnd Sub",
      "observed": "Sub GIUpdateTimer_Timer\r\n Debug.Print \"INITIAL_TIMER|GIUpdateTimer|\" & GameTime & \"|\" & Abs(CLng(GIUpdateTimer.Enabled)) & \"|\" & GIUpdateTimer.Interval\n    Dim tmp, obj\r\n    tmp = Getballs\r\n    If UBound(tmp) <> OldGiState Then\r\n        OldGiState = Ubound(tmp)\r\n        If UBound(tmp) = -1 Then '-1 means no balls, 0 is the first captive ball, 1 is the second captive ball...)\r\n            GiOff                ' turn off the gi if no active balls on the table, we could also have used the variable ballsonplayfield.\r\n        Else\r\n            Gion\r\n        End If\r\n    End If\r\nEnd Sub"
    },
    {
      "name": "FinniDmdAnimationTimer",
      "originalSHA256": "858954d0d49eb591dee227be8450e8c6c795fce53733aff24a1e835c58ff69f5",
      "original": "Sub FinniDmdAnimationTimer_Timer()\r\n    If Not FinniDmdMotion Then Exit Sub\r\n    If Not FinniDmdAnimated(dLine(2)) Then Exit Sub\r\n    FinniDmdFrame = (FinniDmdFrame + 1) Mod 12\r\n    DMDUpdate 2\r\nEnd Sub",
      "observed": "Sub FinniDmdAnimationTimer_Timer()\r\n Debug.Print \"INITIAL_TIMER|FinniDmdAnimationTimer|\" & GameTime & \"|\" & Abs(CLng(FinniDmdAnimationTimer.Enabled)) & \"|\" & FinniDmdAnimationTimer.Interval\n    If Not FinniDmdMotion Then Exit Sub\r\n    If Not FinniDmdAnimated(dLine(2)) Then Exit Sub\r\n    FinniDmdFrame = (FinniDmdFrame + 1) Mod 12\r\n    DMDUpdate 2\r\nEnd Sub"
    }
