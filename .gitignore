!/output/playfield-party-v6/original-plastic-alpha-map.json
!/output/playfield-party-v6/mission-art-map.json
!/output/playfield-party-v6/vpx-light-overrides/
/output/playfield-party-v9/*review*.html
/output/playfield-party-v9/*-detail.png
/output/playfield-party-v9/*validation.json
/output/vpx-v1/*
!/output/vpx-v1/finni-table-layout-source.blend
!/output/vpx-v1/finni-fox-atlas.png
!/output/vpx-v1/finni-party-hardware.glb

# Superseded font trials and downloaded reference-page caches stay local.
/assets/fonts/anton/
/assets/fonts/lilita-one/
/assets/finni/website-assets.*
/references/deadpool/*.webp
/references/deadpool/*.html

# Approved chore redesign and its generated illustration.
!/output/playfield-party-v10/
