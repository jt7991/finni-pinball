*.blend1

# Local recordings, captures and review pages are not project assets.
*.mp4
*.webm
*.mov
*.avi
*.wav
!/assets/finni/audio/doorbell.wav
!/three/public/audio/*.wav
!/assets/finni/audio/mini-finni/*.wav
*.log
*.pyc

# Accepted art, its composition inputs, and model source/export only.
# Update this allowlist when accepting a new revision.
/output/*
!/output/playfield-party-v6/
!/output/playfield-party-v9/
!/output/vpx-v1/
/output/playfield-party-v6/*
!/output/playfield-party-v6/finni-playfield-base.svg
!/output/playfield-party-v6/mission-party-environment.png
!/output/playfield-party-v6/back-panel.png
